# ══════════════════════════════════════════════════════════
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO (RAILWAY)
# ══════════════════════════════════════════════════════════
# 
# Configure estas variáveis no painel do Railway:
# Settings → Variables → Add Variable
#

# Configurações do Servidor
PORT=3000
NODE_ENV=production

# Banco de Dados PostgreSQL
# OBRIGATÓRIO: Use DATABASE_URL
DATABASE_URL=postgresql://user:password@host:5432/database

# Exemplos de DATABASE_URL:
# Supabase: postgresql://postgres.abcdefgh:senha@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Railway:  postgresql://postgres:senha@containers-us-west-123.railway.app:5432/railway

# Segurança
# IMPORTANTE: Gere valores seguros!
# Para JWT_SECRET, use: openssl rand -base64 32
JWT_SECRET=GERE_UMA_CHAVE_SECRETA_FORTE_AQUI
ADMIN_PASSWORD=SuaSenhaAdminSegura123!

# CORS
# Substitua pelo domínio do Railway após o deploy
ALLOWED_ORIGINS=https://seu-app.up.railway.app

# ══════════════════════════════════════════════════════════
# INSTRUÇÕES:
# ══════════════════════════════════════════════════════════
#
# 1. NÃO commite este arquivo com valores reais
# 2. Configure as variáveis diretamente no Railway
# 3. Para gerar JWT_SECRET seguro:
#    openssl rand -base64 32
# 4. Atualize ALLOWED_ORIGINS após o deploy
# 5. DATABASE_URL deve começar com "postgresql://" (não "postgres://")
#
